PORT=5000
# Password special chars must be URL-encoded (@ -> %40)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
# Razorpay test-mode credentials (Dashboard > Settings > API Keys / Webhooks). Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Notification emails (welcome, booking receipt, reminders, OTP). Leave SMTP_HOST/SMTP_USER empty
# and nothing is sent - mails are logged to the console instead, so local dev works without them.
# Gmail: SMTP_PASS must be a 16 character App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=CareNest
# Wall-clock timezone of the clinic: used for slot times and for dates shown in emails
CLINIC_TIMEZONE=Asia/Kolkata
